# Copy this to .env.prod and fill in your values
# NEVER commit .env.prod to git

# PostgreSQL
POSTGRES_USER=mytai_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mytai_db
DATABASE_URL=postgresql+asyncpg://mytai_user:CHANGE_ME@db:5432/mytai_db

# TimescaleDB
TIMESCALE_USER=mytai_ts_user
TIMESCALE_PASSWORD=CHANGE_ME
TIMESCALE_DB=mytai_ts_db
TIMESCALE_URL=postgresql+asyncpg://mytai_ts_user:CHANGE_ME@timescaledb:5432/mytai_ts_db

# Auth
SECRET_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI / External APIs
GOOGLE_API_KEY=
USDA_API_KEY=
GOOGLE_HEALTH_CLIENT_ID=34668407605-ost28jkbt6b89cpokee4uqhbcl0oriik.apps.googleusercontent.com
