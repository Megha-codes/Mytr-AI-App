# Mytr.AI backend — environment template.
#
# Copy to backend/.env and fill in real values. backend/.env is gitignored
# (see the repo-root .gitignore: `.env`, `.env.*`, with `!.env.example`), so
# your real credentials never get committed. NEVER put real secrets in this
# example file. Nothing here is ever logged by the app.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Required. Signing key for user JWTs. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# ── Databases ─────────────────────────────────────────────────────────────────
# Main app Postgres (users, auth, pairing, device readings).
DATABASE_URL=postgresql+asyncpg://mytai_user:mytai_password@localhost:5432/mytai_db
# TimescaleDB (mobile glucose_readings hypertable).
TIMESCALE_DATABASE_URL=postgresql+asyncpg://mytai_ts_user:mytai_ts_password@localhost:5433/mytai_ts_db
# Device-pipeline store. Unset -> falls back to DATABASE_URL (device tables live
# in the main Postgres). Point it at SQLite for a fully-offline run, e.g.:
#   DEVICE_DATABASE_URL=sqlite+aiosqlite:///./mytr_device.db
# DEVICE_DATABASE_URL=

# ── LibreLinkUp poller (mytr-desk device pipeline) ────────────────────────────
# The LibreLinkUp account the backend polls server-side for glucose readings.
LIBRE_EMAIL=
LIBRE_PASSWORD=
# Regional API host: us | eu | de | fr | jp | ap | au | ca. A wrong region makes
# login return a redirect naming the correct one.
LIBRE_REGION=ap
# IANA timezone the account's naive Libre timestamps are in, e.g.
# "Asia/Kolkata" or "America/New_York". Used to convert the timezone-less
# LibreLinkUp timestamps to UTC. If unset, timestamps are treated as UTC.
LIBRE_ACCOUNT_TIMEZONE=
# Seconds between poll cycles (Libre updates ~once a minute).
LIBRE_POLL_INTERVAL_S=60
# Set true to start the in-process poller on app startup.
LIBRE_POLLER_ENABLED=false

# ── Pairing ───────────────────────────────────────────────────────────────────
# Minutes a QR pairing session stays valid.
PAIRING_SESSION_TTL_MIN=10
